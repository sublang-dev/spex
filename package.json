{
  "name": "spex-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Spex: the desktop app for running playbooks, and the @sublang/spex scaffold CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sublang-ai/spex.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "start:server": "node scripts/start-server.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:scripts && npm test --workspaces --if-present",
    "test:scripts": "node --test scripts/desktop-runner.test.mjs scripts/source-launch.integration.test.mjs scripts/live-output.test.mjs",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "e2e": "npm run journeys -w e2e",
    "e2e:live": "npm run journeys:live -w e2e",
    "smoke": "node scripts/smoke.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "smoke:migration": "node scripts/migration-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "node-gyp": "^12.4.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@44.0.0": true,
    "esbuild@0.28.2": true
  }
}
