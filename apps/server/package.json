  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "@openai/codex-sdk": "*",
    "@opencode-ai/sdk": "*",
    "@sublang/spex-core": "*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.0",
    "typescript": "^7.0.2",
    "ws": "^8.18.0"
  }
